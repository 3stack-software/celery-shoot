{
  "name": "celery-shoot",
  "version": "5.0.0-alpha.8",
  "type": "module",
  "main": "dist/celery-shoot.cjs.js",
  "module": "dist/celery-shoot.esm.js",
  "description": "Celery client for Node (Forked from node-celery)",
  "author": "Nathan Muir <ndmuir@gmail.com>",
  "contributors": [
    "Mher Movsisyan <mher.movsisyan@gmail.com>"
  ],
  "dependencies": {
    "amqplib": "^0.8.0",
    "bluebird": "^3.7.2",
    "debug": "^4.1.1",
    "rxjs": "^7.5.3",
    "uuid": "^3.3.2"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/3stack-software/celery-shoot.git"
  },
  "devDependencies": {
    "@babel/core": "^7.22.8",
    "@babel/eslint-parser": "^7.22.7",
    "@babel/preset-env": "^7.22.10",
    "@rollup/plugin-babel": "^6.0.3",
    "@rollup/plugin-node-resolve": "^15.1.0",
    "@rollup/plugin-replace": "^5.0.2",
    "eslint": "^8.44.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-import": "^2.27.5",
    "mocha": "^10.2.0",
    "prettier": "^3.0.0",
    "rollup": "^3.27.0"
  },
  "eslintConfig": {
    "parser": "@babel/eslint-parser",
    "parserOptions": {
      "sourceType": "module",
      "requireConfigFile": false
    },
    "extends": [
      "airbnb-base",
      "prettier"
    ],
    "rules": {
      "no-underscore-dangle": "off",
      "no-await-in-loop": "off",
      "no-restricted-syntax": "off"
    }
  },
  "prettier": {
    "singleQuote": true,
    "trailingComma": "all"
  },
  "engine": {
    "node": ">=14"
  },
  "license": "MIT",
  "scripts": {
    "build": "npx rollup -c",
    "dev": "npx rollup -c -w",
    "test": "env NODE_OPTIONS=\"--experimental-specifier-resolution=node\" npx mocha test/test_celery.js",
    "pretest": "npm run build"
  }
}
