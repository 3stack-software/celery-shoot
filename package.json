{
  "name": "celery-shoot",
  "version": "5.0.0-alpha.7",
  "main": "dist/celery-shoot.cjs.js",
  "module": "dist/celery-shoot.esm.js",
  "description": "Celery client for Node (Forked from node-celery)",
  "author": "Nathan Muir <ndmuir@gmail.com>",
  "contributors": [
    "Mher Movsisyan <mher.movsisyan@gmail.com>"
  ],
  "dependencies": {
    "amqplib": "^0.8.0",
    "bluebird": "^3.7.2",
    "debug": "^4.1.1",
    "rxjs": "^7.5.3",
    "uuid": "^3.3.2"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/3stack-software/celery-shoot.git"
  },
  "devDependencies": {
    "@babel/core": "^7.1.2",
    "@babel/plugin-proposal-class-properties": "^7.1.0",
    "@babel/preset-env": "^7.1.0",
    "babel-eslint": "^10.0.1",
    "builtin-modules": "^3.0.0",
    "eslint": "^8.2.0",
    "eslint-config-airbnb": "^19.0.0",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-import": "^2.25.3",
    "eslint-plugin-jsx-a11y": "^6.5.1",
    "eslint-plugin-prettier": "^4.0.0",
    "eslint-plugin-react": "^7.27.0",
    "git-rev-sync": "^3.0.2",
    "mocha": "^9.2.0",
    "prettier": "^2.4.1",
    "rollup": "^0.67.0",
    "rollup-plugin-babel": "^4.0.3",
    "rollup-plugin-node-resolve": "^3.4.0",
    "rollup-plugin-replace": "^2.1.0"
  },
  "eslintConfig": {
    "parser": "babel-eslint",
    "extends": [
      "airbnb",
      "plugin:prettier/recommended"
    ],
    "rules": {
      "no-underscore-dangle": "off",
      "no-await-in-loop": "off",
      "no-restricted-syntax": "off"
    }
  },
  "prettier": {
    "singleQuote": true,
    "trailingComma": "all"
  },
  "engine": {
    "node": ">=14"
  },
  "license": "MIT",
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c -w",
    "test": "node test/test.js",
    "pretest": "npm run build"
  }
}
